{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true,
      "legal": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 17 * * 1-5"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/bgm-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/bgm-dispatch",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/bgm-resolution-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
